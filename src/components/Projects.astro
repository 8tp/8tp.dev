---
import SectionLabel from "./SectionLabel.astro";
import ProjectCard from "./ProjectCard.svelte";
import { spotlights, featured, rest } from "~/data/projects";
---

<section class="reveal" id="projects" style="--reveal-delay: 160ms">
  <SectionLabel index="02" label="projects" cmd="ls repos/" />

  {spotlights.length > 0 && (
    <div class="mb-3 sm:mb-5 grid gap-3 sm:gap-5 lg:grid-cols-2">
      {spotlights.map((p, i) => <ProjectCard project={p} spotlight index={i + 1} />)}
    </div>
  )}

  <div class="border border-border bg-panel">
    <div class="flex items-center justify-between border-b border-border bg-fg text-panel px-3 py-1 font-mono text-[10px] uppercase">
      <span>// featured</span>
      <a href="https://github.com/8tp" target="_blank" rel="noopener noreferrer" class="ink-link hover:bg-panel hover:text-fg px-1 transition-colors">
        all repos -&gt;
      </a>
    </div>

    <div class="divide-y divide-border">
      {featured.map((p, i) => <ProjectCard project={p} index={spotlights.length + i + 1} />)}
    </div>
  </div>

  <div class="mt-3 sm:mt-5 border border-border bg-panel">
    <div class="flex items-center justify-between border-b border-border bg-fg text-panel px-3 py-1 font-mono text-[10px] uppercase">
      <span>// terminal &amp; macOS</span>
      <span>{rest.length} more</span>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-2 sm:gap-3 p-2 sm:p-3">
      {rest.map((p, i) => <ProjectCard project={p} compact index={spotlights.length + featured.length + i + 1} />)}
    </div>
  </div>
</section>
