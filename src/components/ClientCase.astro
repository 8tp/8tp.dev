---
import type { ClientCase } from "~/data/clients";
import { logoFor, isThemed } from "~/data/logos";

interface Props {
  study: ClientCase;
}

const { study } = Astro.props;
const host = new URL(study.website).host;
const logo = logoFor(study.slug);
---

<article class="case" id={study.slug}>
  <div class="case-head">
    {logo && (
      <span class="case-mark" aria-hidden="true">
        {isThemed(logo) ? (
          <>
            <img class="logo-light" src={logo.light} alt="" loading="lazy" decoding="async" />
            <img class="logo-dark" src={logo.dark} alt="" loading="lazy" decoding="async" />
          </>
        ) : (
          <img src={logo.src} alt="" loading="lazy" decoding="async" />
        )}
      </span>
    )}
    <h3 class="entry-name">{study.title}</h3>
    <span class="soft">{study.year}</span>
    <a class="link link-muted case-site" href={study.website} rel="noopener" target="_blank">
      {host}
    </a>
  </div>

  <p class="prose muted case-summary">{study.summary}</p>
  <p class="stack case-stack">{study.role} · {study.stack.join(" · ")}</p>

  <figure class="case-frame">
    {/* Aeperion has its own light/dark switcher, so the frame follows this
        site's theme rather than showing a light storefront on dark paper.
        Both are in the markup and CSS picks one, so the swap is instant. */}
    <img
      class:list={["frame-shot", study.image.srcDark && "frame-light"]}
      src={study.image.src}
      alt={study.image.alt}
      width={study.image.width}
      height={study.image.height}
      loading="lazy"
      decoding="async"
    />
    {study.image.srcDark && (
      <img
        class="frame-shot frame-dark"
        src={study.image.srcDark}
        alt={study.image.alt}
        width={study.image.width}
        height={study.image.height}
        loading="lazy"
        decoding="async"
      />
    )}
    <figcaption class="soft">{study.image.caption}</figcaption>
  </figure>
</article>

<style>
  .case-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
  }

  /* Sized and seated to match a project entry's mark, so the client case reads
     as the same kind of row even though it is not an EntryList. */
  .case-mark {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    /* Nudged off the baseline the flex row aligns to, onto the title's cap. */
    align-self: center;
    margin-right: -0.35rem;
  }

  .case-mark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 22%;
  }

  :global(html[data-theme="dark"]) .case-mark .logo-light,
  :global(html[data-theme="light"]) .case-mark .logo-dark {
    display: none;
  }

  .case-site {
    font-size: var(--text-xs);
  }

  .case-summary {
    margin-top: 0.35rem;
  }

  .case-stack {
    margin-top: 0.35rem;
  }

  .case-frame {
    margin-top: 1.25rem;
    max-width: var(--measure-wide);
  }

  .case-frame .frame-shot {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: var(--hairline) solid var(--ink-faint);
  }

  :global(html[data-theme="dark"]) .frame-light,
  :global(html[data-theme="light"]) .frame-dark {
    display: none;
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: var(--text-xs);
  }
</style>
