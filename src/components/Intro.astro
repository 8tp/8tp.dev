---
import { site } from "~/data/site";
---

<!-- The opening row of the page grid: who, in the label column; what, in the
     content column, set large enough to read as a statement. -->
<section class="intro grid" aria-label="Introduction">
  <p class="who meta">
    {site.role}<br />
    {site.author.location}
  </p>

  <div>
    <p class="lede">{site.tagline}</p>

    <p class="prose">
      For clients, that has meant a Shopify storefront and an aim trainer for a mousepad maker,
      and a mouse-ranking site for a YouTube reviewer. My own projects range from a browser shooter
      to a Mac app for filling in PDF forms.
    </p>

    {site.availability && <p class="prose">{site.availability}</p>}
  </div>
</section>

<style>
  .intro {
    padding-block: clamp(2.5rem, 8vw, 5.5rem) var(--section-gap);
  }

  .who {
    line-height: 1.6;
  }

  @media (min-width: 52rem) {
    /* Sit on the lede's first line rather than the top of its line box. */
    .who {
      padding-top: 0.5rem;
    }
  }

  .lede {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.22;
    letter-spacing: -0.005em;
    max-width: 22em;
    text-wrap: balance;
    margin-bottom: 1.4rem;
  }
</style>
