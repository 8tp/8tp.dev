---
import "~/styles/global.css";
import { site } from "~/data/site";
import ThemeToggle from "~/components/ThemeToggle.svelte";
import Footer from "~/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.seoTitle, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImage = new URL(site.og.image, site.url).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.author.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  description: site.tagline,
  sameAs: site.socials.map((s) => s.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <link rel="canonical" href={canonical} />

    <!-- One tag, rewritten by the head script and the toggle. -->
    <meta name="theme-color" content={site.themeColor.light} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="alternate icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.og.width)} />
    <meta property="og:image:height" content={String(site.og.height)} />
    <meta property="og:image:alt" content={site.og.alt} />
    <meta property="og:site_name" content={site.author.name} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.og.alt} />

    <script is:inline define:vars={{ themeColor: site.themeColor }}>
      // Resolve the theme before first paint so there is no flash, and keep
      // theme-color honest. The toggle island takes over once hydrated.
      (function () {
        var theme = "light";
        try {
          var stored = localStorage.getItem("theme");
          theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        } catch (e) {
          /* Storage blocked — light is the default. */
        }
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          .setAttribute("content", theme === "dark" ? themeColor.dark : themeColor.light);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="page shell">
      <header class="site-head">
        <ThemeToggle client:idle />
      </header>

      <!-- tabindex="-1" so the skip link moves focus, not just the viewport. -->
      <main id="main" tabindex="-1">
        <slot />
      </main>

      <Footer />
    </div>

    <style>
      .site-head {
        display: flex;
        justify-content: flex-end;
        padding-block: 0.75rem 0;
        /* The toggle's 2rem box sits flush with the measure. */
        margin-right: -0.5rem;
      }
    </style>
  </body>
</html>
