---
import Layout from "~/layouts/Layout.astro";
import Intro from "~/components/Intro.astro";
import EntryList from "~/components/EntryList.svelte";
import ClientCase from "~/components/ClientCase.astro";
import Contact from "~/components/Contact.astro";
import { featured, also, childrenOf, allReposUrl, type Project } from "~/data/projects";
import { markFor } from "~/data/marks";
import { logoFor } from "~/data/logos";
import { tech } from "~/data/stack";
import { cases, casesUnder } from "~/data/clients";

/** Flatten a Project into the shape the ledger renders. */
const toEntry = (project: Project) => {
  const links = [];
  if (project.website) links.push({ label: project.verb ?? "Visit", href: project.website });
  if (project.source) links.push({ label: "Source", href: project.source });
  return {
    slug: project.slug,
    name: project.name,
    blurb: project.blurb,
    href: project.website ?? project.source,
    links,
    trailer: project.trailer ?? null,
    stack: tech(project.stack),
    child: project.tier === "child",
    preview: project.preview ?? null,
    mark: markFor(project.slug),
    logo: logoFor(project.slug),
  };
};

/* Children sit directly under their parent rather than in a tier of their own. */
const work = featured.flatMap((project) => [project, ...childrenOf(project.slug)]).map(toEntry);

/* "a, b; c; and d." */
const separator = (i: number) => (i < also.length - 2 ? "; " : i === also.length - 2 ? "; and " : ".");

/* Keep in step with the .peek breakpoint in EntryList.svelte. */
const PEEK = "(min-width: 52rem) and (hover: hover) and (pointer: fine)";
---

<Layout home>
  <Intro />

  <section class="section grid" aria-labelledby="client-heading">
    <h2 class="section-title" id="client-heading">Client work</h2>
    <div>
      {cases.map((study) => <ClientCase study={study} under={casesUnder(study.slug)} />)}
    </div>
  </section>

  <section class="section grid" aria-labelledby="work-heading">
    <h2 class="section-title" id="work-heading">Own projects</h2>
    <div>
      <EntryList entries={work} client:media={PEEK} />

      <!-- Each item on one line: Astro pads the seams around expressions that
           break across lines, and the punctuation ends up floating. -->
      <p class="prose also">
        Also: {also.map((project, i) => <><a class="link" href={project.website ?? project.source} rel="noopener" target="_blank">{project.name}</a>, {project.blurb}{separator(i)}</>)} The rest is on <a class="link" href={allReposUrl} rel="noopener" target="_blank">GitHub</a>.
      </p>
    </div>
  </section>

  <section class="section grid" aria-labelledby="contact-heading">
    <h2 class="section-title" id="contact-heading">Contact</h2>
    <Contact />
  </section>
</Layout>

<style>
  .also {
    margin-top: 1.4rem;
    font-size: var(--text-sm);
  }
</style>
