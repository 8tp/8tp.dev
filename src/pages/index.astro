---
import Layout from "~/layouts/Layout.astro";
import Intro from "~/components/Intro.astro";
import EntryList from "~/components/EntryList.svelte";
import ClientCase from "~/components/ClientCase.astro";
import Contact from "~/components/Contact.astro";
import { featured, more, childrenOf, type Project } from "~/data/projects";
import { markFor } from "~/data/marks";
import { clients } from "~/data/clients";

/** Flatten a Project into the shape EntryList renders. */
const toEntry = (project: Project, { stack = true } = {}) => ({
  slug: project.slug,
  name: project.name,
  blurb: project.blurb,
  stack: stack ? project.stack : undefined,
  href: project.website ?? project.source,
  sourceHref: project.source,
  preview: project.preview ?? null,
  mark: markFor(project.slug),
});

/* Children sit directly under their parent rather than in a tier of their own. */
const work = featured
  .flatMap((project) => [project, ...childrenOf(project.slug)])
  .map((project) => toEntry(project));

/* The "more" list is name + one sentence — no stack lines. */
const moreEntries = more.map((project) => toEntry(project, { stack: false }));

/* Keep in step with the .peek breakpoint in EntryList.svelte. */
const PEEK = "(min-width: 52rem) and (hover: hover) and (pointer: fine)";
---

<Layout>
  <Intro />

  <section class="section" aria-labelledby="work-heading">
    <h2 class="section-title" id="work-heading">Selected work</h2>
    <EntryList entries={work} client:media={PEEK} />
  </section>

  <section class="section" aria-labelledby="client-heading">
    <h2 class="section-title" id="client-heading">Client work</h2>
    {clients.map((study) => <ClientCase study={study} />)}
  </section>

  <section class="section" aria-labelledby="more-heading">
    <h2 class="section-title" id="more-heading">More</h2>
    <EntryList entries={moreEntries} split client:media={PEEK} />
  </section>

  <section class="section" aria-labelledby="contact-heading">
    <h2 class="section-title" id="contact-heading">Contact</h2>
    <Contact />
  </section>
</Layout>
